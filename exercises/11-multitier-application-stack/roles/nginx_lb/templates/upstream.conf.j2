# Dynamic upstream generated from appservers group
upstream backend_app_pool {
    {% for host in groups['appservers'] %}
    server {{ host }}:{{ hostvars[host]['app_port'] }};
    {% endfor %}
}

server {
    listen {{ lb_port }};
    server_name _;

    location / {
        proxy_pass http://backend_app_pool;
        proxy_set_header Host $host;
    }
}
