# ==============================================================================
# Managed by Ansible: DO NOT EDIT DIRECTLY
# Target Node: {{ inventory_hostname }}
# Generated Environment: {{ deploy_env | default('production') | upper }}
# ==============================================================================

events {
    worker_connections {{ worker_connections | default(1024) }};
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    # Dynamic Upstream Pool
    upstream {{ app_name }}_cluster {
        least_conn;
        {% for node in upstream_nodes -%}
        server {{ node.ip }}:{{ node.port }} max_fails=3 fail_timeout=15s;
        {% endfor %}
    }

    server {
        listen {{ http_port | default(80) }};
        server_name {{ server_domain }};

        {% if ssl_enabled | default(false) %}
        # SSL Termination Configuration
        listen 443 ssl http2;
        ssl_certificate     /etc/ssl/certs/{{ server_domain }}.crt;
        ssl_certificate_key /etc/ssl/private/{{ server_domain }}.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        {% endif %}

        # Dynamic Routing Rules
        {% for route in routing_rules %}
        location {{ route.path }} {
            proxy_pass http://{{ route.backend_service }};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
        }
        {% endfor %}

        # Health probe endpoint
        location /healthz {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }
    }
}
