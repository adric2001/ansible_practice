# CIS Hardened SSH Daemon Configuration
# Managed by Ansible

Port {{ ssh_port | default(22) }}
Protocol 2
LogLevel VERBOSE

# Authentication Controls
PermitRootLogin {{ ssh_permit_root_login | default('no') }}
PasswordAuthentication {{ ssh_password_authentication | default('no') }}
PermitEmptyPasswords no
MaxAuthTries {{ ssh_max_auth_tries | default(3) }}
PubkeyAuthentication yes

# Session & Timeouts
ClientAliveInterval {{ ssh_client_alive_interval | default(300) }}
ClientAliveCountMax {{ ssh_client_alive_count_max | default(0) }}
X11Forwarding no
MaxSessions 4

# Cryptographic Controls (Modern Ciphers & MACs)
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512
